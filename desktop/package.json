{
  "name": "ti-toolbox-desktop",
  "version": "3.0.0-dev.1",
  "description": "TI-Toolbox v3 desktop shell (Electron) and web UI served by tit.server",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Ido Haber",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:launcher": "npm run dev",
    "dev:web": "tsx scripts/dev.ts --web",
    "dev:host": "tsx scripts/dev.ts --host --web",
    "dev:down": "tsx scripts/dev.ts --down",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "pree2e": "cross-env VITE_INCLUDE_GALLERY=1 VITE_SCENE_HOOKS=1 electron-vite build",
    "e2e": "playwright test",
    "mock-server": "node tests/mock-server/server.mjs",
    "gen": "python3 ../dev/build_contracts.py && npm run gen:api",
    "gen:api": "openapi-typescript ../contracts/generated/openapi.json -o src/renderer/api/schema.d.ts",
    "e2e:quiet": "bash scripts/e2e-quiet-check.sh npm run e2e",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --publish never",
    "package:dir": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --config electron-builder.yml --publish never",
    "verify:package": "node scripts/verify-package.mjs release"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.10",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "katex": "0.16.25",
    "lucide-react": "1.34.0",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.86.0",
    "react-router-dom": "7.18.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "uplot": "1.6.32",
    "yaml": "2.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
