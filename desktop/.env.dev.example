# Optional defaults for pnpm dev; command-line/environment values take precedence.
TIT_DEV_PROJECT_DIR=/Users/you/datasets/000
# Empty uses the image selected by the root docker-compose.yml.
TIT_DEV_IMAGE_TAG=
TIT_DEV_PORT=8765
# Mount the checkout; set 0 only when testing the baked image.
TIT_DEV_MOUNT_REPO=1
# For --host, TIT_DEV_PYTHON selects a local Python with server/science dependencies.
