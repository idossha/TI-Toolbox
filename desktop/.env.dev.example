# desktop/.env.dev — configuration for `npm run dev` (P1, dev/notes/v3-pipelines-program.md §2).
#
#   cp .env.dev.example .env.dev   and edit TIT_DEV_PROJECT_DIR.
#
# .env.dev is git-ignored: it names a path on one machine. This example file is committed so the
# variable names and their defaults have exactly one home. Anything here can be overridden for a
# single run from the shell (the shell wins over the file), e.g. TIT_DEV_PORT=8766 npm run dev.

# REQUIRED. The BIDS project directory the container is opened for; mounted at /mnt/<its name>.
# There is no default on purpose: guessing one would open a container against the wrong data.
TIT_DEV_PROJECT_DIR=/Users/you/datasets/000

# Which idossha/ti-toolbox:<tag> to run. Default: dev.
TIT_DEV_IMAGE_TAG=dev

# Host port the container publishes and the app connects to. Default: 8765. A second checkout
# working on a second project at the same time needs a second port here.
TIT_DEV_PORT=8765

# 1 (default) bind-mounts THIS worktree at /ti-toolbox with PYTHONPATH=/ti-toolbox, so every job
# runner imports the working tree, and runs tit.server with --reload --reload-dir /ti-toolbox/tit,
# so an edit under tit/server/** or tit/jobs/** restarts the server on its own.
# 0 runs the image's own baked-in tit — which is what a user gets, and therefore what to set when
# you are testing the image rather than the code.
TIT_DEV_MOUNT_REPO=1
