# Dockerfile.ti-toolbox — the one recipe for idossha/ti-toolbox:<ver>.
#
#   SimNIBS 4.6 + tit + tit.server (serves the built UI) + FastSurfer + headless Blender.
#   TetraVox is not in the image: the desktop app installs it on the host.
#
# Built by container/blueprint/build.sh; container/blueprint/README.md explains the choices.
#
# Stages:  source -> ui-builder, fastsurfer, blender  ->  final (ubuntu:22.04)
# Only the final stage is shipped; the others hand it files and are discarded.

# =========================================================================================
# Helper stages
# =========================================================================================

# --- source: the TI-Toolbox tree, from the local checkout (default) or a git ref ---
ARG TI_TOOLBOX_SOURCE=local

FROM --platform=$BUILDPLATFORM alpine/git:2.45.2 AS source-clone
ARG TI_TOOLBOX_REF=main
ARG CACHE_BUST
RUN git clone --branch "${TI_TOOLBOX_REF}" --single-branch --depth 1 \
        https://github.com/idossha/TI-Toolbox.git /ti-toolbox \
    && rm -rf /ti-toolbox/.git

FROM --platform=$BUILDPLATFORM alpine:3.20 AS source-local
COPY . /ti-toolbox

FROM source-${TI_TOOLBOX_SOURCE} AS source

# --- ui-builder: the web UI that tit.server serves (desktop app and browser mode) ---
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS ui-builder
COPY --from=source /ti-toolbox/desktop /build/desktop
WORKDIR /build/desktop
# --ignore-scripts: node-pty (Assistant host terminal) is Electron-main-only and compiles natively; the renderer build needs no install script.
RUN npm ci --ignore-scripts && npm run build

# --- fastsurfer: source checkout; its Python deps are installed in the final stage ---
FROM ubuntu:22.04 AS fastsurfer
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ARG FASTSURFER_REF=v2.5.4
RUN git clone --depth 1 --branch "${FASTSURFER_REF}" \
        https://github.com/Deep-MI/FastSurfer.git /opt/fastsurfer \
    && rm -rf /opt/fastsurfer/.git

# --- blender: official build with its own Python (bpy inside SimNIBS would downgrade NumPy 2) ---
FROM ubuntu:22.04 AS blender
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*
# The checksum is Blender's official one, so a mirror passed via build.sh is verified too.
ARG BLENDER_ARCHIVE_URL=https://mirror.blender.org/release/Blender4.4/blender-4.4.3-linux-x64.tar.xz
RUN mkdir -p /opt/blender \
    && curl -fL --retry 3 --retry-all-errors "$BLENDER_ARCHIVE_URL" -o /tmp/blender.tar.xz \
    && echo "8d3be07d2bc412b502c6bfe3cfe3e22195a4164076867da987ce148d73c27946  /tmp/blender.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/blender.tar.xz --strip-components=1 -C /opt/blender \
    && rm /tmp/blender.tar.xz

# =========================================================================================
# Final image
# =========================================================================================
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

# --- 1. System packages ---
# No X11 server or Qt. Mesa/EGL and the libX*/libSM/libICE/libxkbcommon libraries are what
# headless Blender links against. ImageMagick + DejaVu annotate montage PNGs. gnupg and
# lsb-release are for the Docker apt repository below.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates wget curl git tzdata fontconfig imagemagick fonts-dejavu-core \
        libglib2.0-0 \
        libgl1-mesa-glx libglu1-mesa libgl1-mesa-dri libglapi-mesa libosmesa6 libegl1-mesa libgbm1 \
        libxrender1 libxi6 libsm6 libice6 libxkbcommon0 \
        dcm2niix \
        gnupg lsb-release \
    && convert -version \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Docker CLI: QSIPrep/QSIRecon run as sibling containers (tit/pre/qsi/utils.py).
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu jammy stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- 2. SimNIBS 4.6, official Linux installer ---
# Avoids the OpenMP affinity crash in SimNIBS/numpy during postinstall and under emulation.
ENV OMP_NUM_THREADS=1
ENV KMP_AFFINITY=disabled

# After installing, drop what a headless TES toolbox never reaches:
#   gmsh (92 MB)   only simnibs/cli/gmsh_cli.py, the GUI launcher; nothing links libgmsh
#   PyQt5 (202 MB) only simnibs/GUI and postinstall; tit imports no Qt
#   coil models    TMS-only data (41 MB); file_finder.coil_models is just a path join
#   documentation  HTML docs
RUN mkdir -p /simnibs \
    && wget -q https://github.com/simnibs/simnibs/releases/download/v4.6.0/simnibs_installer_linux.tar.gz -P /simnibs \
    && tar -xzf /simnibs/simnibs_installer_linux.tar.gz -C /simnibs \
    && /simnibs/simnibs_installer/install -s \
    && rm -rf /simnibs \
    && R=/root/SimNIBS-4.6 \
    && E=$R/simnibs_env \
    && SP=$E/lib/python3.11/site-packages \
    && rm -rf $R/documentation \
        $R/bin/gmsh $E/bin/gmsh $E/lib/libgmsh.so* $E/lib/gmsh.jl \
        $E/share/gmsh $E/share/doc/gmsh \
        $SP/gmsh.py $SP/__pycache__/gmsh.* $SP/gmsh-*.dist-info \
        $SP/simnibs_master/share/doc/gmsh \
        $R/bin/simnibs_gui $E/bin/simnibs_gui \
        $SP/PyQt5 $SP/PyQt5-*.dist-info $SP/pyqt5_*.dist-info \
        $SP/simnibs/GUI \
        $SP/simnibs/resources/coil_models

ENV PATH="/root/SimNIBS-4.6/bin:$PATH"
ENV SIMNIBSDIR="/root/SimNIBS-4.6"

# --- 3. Blender ---
COPY --from=blender /opt/blender /opt/blender
ENV TIT_BLENDER_BIN=/opt/blender/blender

# --- 4. Python packages tit imports ---
# The constraints file keeps SimNIBS's NumPy ABI and pins the PyTorch/CUDA set below.
COPY --from=source /ti-toolbox/container/blueprint/runtime-constraints.txt /opt/ti-runtime-constraints.txt
ENV PIP_CONSTRAINT=/opt/ti-runtime-constraints.txt

# mne is a range on purpose (tit/source/_simnibs_compat.py spans it); h5io is mne's HDF5
# backend; dipy fits the DTI tensor from QSIPrep output (tit/pre/qsi/dti_extractor.py).
RUN simnibs_python -m pip install --no-cache-dir \
        meshio nilearn trimesh seaborn scikit-image numpy-stl click psutil \
        "mne>=1.5,<2" h5io nbformat jupyter_client ipykernel \
        fastapi "uvicorn[standard]" pyyaml "dipy>=1.12,<2"

# --- 5. FastSurfer: CUDA PyTorch, the package, its checkpoints ---
# PyTorch + CUDA is ~6 GB, so it is installed over several layers to keep each one small
# enough for registries with a per-layer size limit. Versions come from the constraints file.
# CUDA libraries ship in these wheels; the NVIDIA driver comes from the host at run time.
ENV FASTSURFER_HOME=/opt/fastsurfer
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu126
RUN simnibs_python -m pip install --no-cache-dir --index-url "$TORCH_INDEX" nvidia-cublas-cu12
RUN simnibs_python -m pip install --no-cache-dir --index-url "$TORCH_INDEX" nvidia-cudnn-cu12
RUN simnibs_python -m pip install --no-cache-dir --index-url "$TORCH_INDEX" \
        nvidia-nvjitlink-cu12 nvidia-cusparse-cu12 nvidia-cusparselt-cu12 nvidia-nccl-cu12
RUN simnibs_python -m pip install --no-cache-dir --index-url "$TORCH_INDEX" \
        nvidia-cufft-cu12 nvidia-cusolver-cu12 nvidia-curand-cu12 nvidia-cufile-cu12 \
        nvidia-cuda-cupti-cu12 nvidia-cuda-nvrtc-cu12 nvidia-cuda-runtime-cu12 nvidia-nvtx-cu12 \
        triton
COPY --from=fastsurfer /opt/fastsurfer /opt/fastsurfer
RUN simnibs_python -m pip install --no-cache-dir --index-url "$TORCH_INDEX" torch torchvision \
    && simnibs_python -m pip install --no-cache-dir -e "${FASTSURFER_HOME}" \
    && simnibs_python -c "import torch; assert torch.version.cuda == '12.6', torch.__version__" \
    && simnibs_python -c "import simnibs.segmentation, brainnet"

# Checkpoints for --vinn (67 MB); production runs skip CerebNet/HypVINN. Downloads from the
# official host, or from a verified mirror passed via build.sh (see the script).
ARG FASTSURFER_CHECKPOINTS_TGZ=""
ARG FASTSURFER_CHECKPOINTS_SHA256=""
COPY --from=source /ti-toolbox/container/blueprint/fastsurfer_checkpoints.sh /opt/fastsurfer_checkpoints.sh
RUN sh /opt/fastsurfer_checkpoints.sh

# --- 6. TI-Toolbox: SimNIBS patches, extra EEG caps, flex-optimisation replacement, tit ---
COPY --from=source /ti-toolbox /ti-toolbox
RUN mkdir -p $SIMNIBSDIR/resources/ElectrodeCaps_MNI/ \
    && cp /ti-toolbox/resources/ElectrodeCaps_MNI/* $SIMNIBSDIR/resources/ElectrodeCaps_MNI/ \
    && cp /ti-toolbox/resources/map-electrodes/tes_flex_optimization.py \
          $SIMNIBSDIR/simnibs/optimization/tes_flex_optimization/tes_flex_optimization.py \
    && simnibs_python /ti-toolbox/resources/atlas2subject/patch_atlas2subject.py \
    && simnibs_python -m pip install --no-cache-dir /ti-toolbox

# Jupyter kernel the in-app notebooks use (tit/server/kernels.py starts it by name).
RUN simnibs_python -m ipykernel install --name simnibs --display-name "SimNIBS + TI-Toolbox"

# Fail the build on ABI/dependency drift once every installer has run.
RUN simnibs_python /ti-toolbox/container/blueprint/verify_runtime.py

# --- 7. Web UI and entrypoint ---
COPY --from=ui-builder /build/desktop/out/renderer /opt/ti-toolbox/ui
COPY --from=source /ti-toolbox/container/blueprint/entrypoint.ti-toolbox.sh /usr/local/bin/entrypoint.ti-toolbox.sh
RUN chmod +x /usr/local/bin/entrypoint.ti-toolbox.sh

# --- 8. Build record: `docker inspect` labels, plus /etc/ti-toolbox-build.json inside ---
ARG TI_TOOLBOX_VERSION=dev
ARG VCS_REF=unknown
ARG VCS_SHA=unknown
ARG VCS_DIRTY=false
ARG BUILD_DATE=unknown
ARG TI_TOOLBOX_SOURCE
ARG TI_TOOLBOX_REF=""
RUN printf '{"version":"%s","sha":"%s","short":"%s","dirty":%s,"source":"%s","ref":"%s","date":"%s"}\n' \
        "${TI_TOOLBOX_VERSION}" "${VCS_SHA}" "${VCS_REF}" "${VCS_DIRTY}" \
        "${TI_TOOLBOX_SOURCE}" "${TI_TOOLBOX_REF}" "${BUILD_DATE}" \
        > /etc/ti-toolbox-build.json
LABEL org.opencontainers.image.title="TI-Toolbox" \
      org.opencontainers.image.version="${TI_TOOLBOX_VERSION}" \
      org.opencontainers.image.revision="${VCS_SHA}" \
      org.opencontainers.image.source="https://github.com/idossha/TI-Toolbox"

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
    CMD curl -fsS "http://127.0.0.1:${TIT_SERVER_PORT:-8765}/api/health" || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.ti-toolbox.sh"]
